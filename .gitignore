# ==========================================
# 1. 环境变量与密钥（极度危险！绝不能传！）
# ==========================================
.env

# ==========================================
# 2. 虚拟环境（几百 MB，绝不能传！）
# ==========================================
venv/
.venv/
env/
ENV/

# ==========================================
# 3. Python 缓存与编译文件
# ==========================================
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo
.pytest_cache/

# ==========================================
# 4. 本地模型（2GB+，不提交）
# ==========================================
models/

# ==========================================
# 5. 向量库（可重建）
# ==========================================
chroma_db/

# ==========================================
# 6. 数据集与文档中的大文件
# ==========================================
# 原始 PDF / 大文件
data/day2_pdfs/
data/day2_raw/
data/day2_cleaned/
data/processed/
data/raw/
data/uploaded_pdfs/
data/*.pdf
docs/*.pdf
docs/*.pptx
docs/*.zip

# 中间产物（体积大，可重建）
data/day3_challenge/
data/day3_outputs/
data/day3_outputs_challenge/
data/day3_outputs_rl/
data/day3_variant_outputs/

# 知识库原始文档（如果里面是大文件，先忽略；如果只是小 JSON，可放开）
data/kb/

# 未下载完的临时文件
*.incomplete

# ==========================================
# 7. 编辑器与系统文件
# ==========================================
.vscode/
.idea/
.DS_Store
Thumbs.db

# ==========================================
# 8. 临时文件与日志
# ==========================================
*.log
*.tmp
*.bak
*.zip
*.tar.gz